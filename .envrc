# Project .envrc - safe loader
# Keep secrets out of this file. Add them to a gitignored `.env` file.

# Non-sensitive defaults
export DEBUG=1ca
export PYTHONPATH=./src

#Litellm defaults
export LITELLM_DEBUG=false
export LITELLM_LOG=INFO

# CAS LLM defaults
export CAS_DEFAULT_PROVIDER=gemini
export CAS_DEFAULT_MODEL=gemini-3.8-flash
#export CAS_TEMPERATURE=1
export CAS_MAX_TOKENS=1000000

# Knowledge Provider root path
export CAS_KNOWLEDGE_WORKSPACE="/Users/avfranco/cas-knowledge"
export KNOWLEDGE_TELEMETRY_OUTPUT_DIR=$CAS_KNOWLEDGE_WORKSPACE/runtime/traces

# Langsmith 
export TRACE_TO_LANGSMITH="true"
export CC_LANGSMITH_PROJECT="coding-agents"

# LangSmith credentials
export LANGSMITH_PROJECT="ideas-to-life-cas"
export LANGSMITH_ENDPOINT="https://api.smith.langchain.com" # default

# LiteLLM callback configuration (can also be set in code)
export LITELLM_SUCCESS_CALLBACKS="langsmith"
export LITELLM_FAILURE_CALLBACKS="langsmith"

# Base OTLP endpoint (exporters automatically append /v1/traces)
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://api.smith.langchain.com/otel/v1/traces"
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.smith.langchain.com/otel"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"

# If a local `.env` exists, load it (export all variables in the file)
if [ -f .env ]; then
	set -a
	# shellcheck disable=SC1091
	source .env
	set +a
fi

# End of .envrc
